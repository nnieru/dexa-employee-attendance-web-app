# Copy to .env and replace every placeholder. Never commit real values.
NODE_ENV=development
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174

# Company business timezone (IANA name). Attendance dates are computed in it; WIB is Asia/Jakarta.
BUSINESS_TIMEZONE=Asia/Jakarta

# Token settings shared by every backend service (libs/common/src/auth). Keys are base64-encoded PEM
# on one line. For local development, run `npm run -s keys:generate` (-s keeps npm's banner out of
# the output), paste the output here, and keep it out of version control. Deployments take their keys from a secret store. Real keys are
# never committed. SERVICE_NAME is not set here: each service defaults to its own name, so one file
# serves every service.
USER_JWT_ISSUER=auth-service
USER_JWT_AUDIENCE=dexa-api
# RS256 user tokens. Only auth-service needs USER_JWT_PRIVATE_KEY; every service needs the public key.
USER_JWT_PUBLIC_KEY=
USER_JWT_PRIVATE_KEY=
# ES256 service tokens. Each service signs with its own private key. Compose maps
# <SERVICE>_SERVICE_JWT_PRIVATE_KEY into that service's container as SERVICE_JWT_PRIVATE_KEY.
SERVICE_JWT_PRIVATE_KEY=
# Public key of every service. Every service reads all of them, so none of these is secret.
API_GATEWAY_SERVICE_JWT_PUBLIC_KEY=
AUTH_SERVICE_SERVICE_JWT_PUBLIC_KEY=
EMPLOYEE_SERVICE_SERVICE_JWT_PUBLIC_KEY=
ATTENDANCE_SERVICE_SERVICE_JWT_PUBLIC_KEY=
NOTIFICATION_SERVICE_SERVICE_JWT_PUBLIC_KEY=
AUDIT_WORKER_SERVICE_JWT_PUBLIC_KEY=

# Infrastructure (compose.yaml)
POSTGRES_ADMIN_PASSWORD=change-me
RABBITMQ_USERNAME=dexa
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://dexa:change-me@127.0.0.1:5672

# One database and role per service
AUTH_DB_PASSWORD=change-me
EMPLOYEE_DB_PASSWORD=change-me
ATTENDANCE_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
AUDIT_DB_PASSWORD=change-me
AUTH_DATABASE_URL=postgres://auth_app:change-me@127.0.0.1:5432/auth_db
# Used by the auth-service container under compose (--profile apps). Inside the compose network,
# Postgres is reachable at the service name postgres.
# AUTH_DATABASE_URL_CONTAINER=postgres://auth_app:change-me@postgres:5432/auth_db
# Used by the auth-service container for the outbox relay. Inside the compose network, the broker is at
# the service name rabbitmq.
# RABBITMQ_URL_CONTAINER=amqp://dexa:change-me@rabbitmq:5672
EMPLOYEE_DATABASE_URL=postgres://employee_app:change-me@127.0.0.1:5432/employee_db
# Used by the employee-service container under compose (--profile apps).
# EMPLOYEE_DATABASE_URL_CONTAINER=postgres://employee_app:change-me@postgres:5432/employee_db
# Organization positions and employee statuses, seeded at startup (DATABASE §2). Unset seeds nothing and
# logs a warning while the master tables are empty. Each code is uppercase; statuses must include ACTIVE
# and INACTIVE. Local development may set the literal value fixtures instead; production refuses it.
# EMPLOYEE_MASTER_DATA={"positions":[{"code":"HR_OFFICER","name":"HR Officer"}],"employeeStatuses":[{"code":"ACTIVE","name":"Active"},{"code":"INACTIVE","name":"Inactive"}]}
ATTENDANCE_DATABASE_URL=postgres://attendance_app:change-me@127.0.0.1:5432/attendance_db
NOTIFICATION_DATABASE_URL=postgres://notification_app:change-me@127.0.0.1:5432/notification_db
AUDIT_DATABASE_URL=postgres://audit_app:change-me@127.0.0.1:5432/audit_db

# First HR account. auth-service creates it at startup only when no HR account exists (DATABASE §3.3).
# Set both or neither: auth-service refuses to start with only one, and production requires both.
# Uncomment both and set a strong password locally (8+ characters, a letter and a number); never
# commit a real one. Docker Compose runs auth-service in production mode, so it needs both.
# AUTH_BOOTSTRAP_HR_EMAIL=hr.admin@example.com
# AUTH_BOOTSTRAP_HR_PASSWORD=

# Internal base URL that api-gateway and employee-service call auth-service through (http or https, no
# credentials). Each user-token request checks the account with auth-service, so both services need it.
# Under compose they reach it at http://auth-service:3000 instead.
AUTH_SERVICE_INTERNAL_URL=http://127.0.0.1:3001

# Internal base URL that api-gateway calls employee-service through (http or https, no credentials).
# Under compose the gateway reaches it at http://employee-service:3000 instead.
EMPLOYEE_SERVICE_INTERNAL_URL=http://127.0.0.1:3002

# Browser-visible API base URL (never put secrets in VITE_* variables)
VITE_API_URL=http://127.0.0.1:3000/api/v1
