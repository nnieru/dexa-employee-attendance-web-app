# Copy to .env and replace every placeholder. Never commit real values.
NODE_ENV=development
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174

# Infrastructure (compose.yaml)
POSTGRES_ADMIN_PASSWORD=change-me
RABBITMQ_USERNAME=dexa
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://dexa:change-me@127.0.0.1:5672

# One database and role per service
AUTH_DB_PASSWORD=change-me
EMPLOYEE_DB_PASSWORD=change-me
ATTENDANCE_DB_PASSWORD=change-me
NOTIFICATION_DB_PASSWORD=change-me
AUDIT_DB_PASSWORD=change-me
AUTH_DATABASE_URL=postgres://auth_app:change-me@127.0.0.1:5432/auth_db
EMPLOYEE_DATABASE_URL=postgres://employee_app:change-me@127.0.0.1:5432/employee_db
ATTENDANCE_DATABASE_URL=postgres://attendance_app:change-me@127.0.0.1:5432/attendance_db
NOTIFICATION_DATABASE_URL=postgres://notification_app:change-me@127.0.0.1:5432/notification_db
AUDIT_DATABASE_URL=postgres://audit_app:change-me@127.0.0.1:5432/audit_db

# Browser-visible API base URL (never put secrets in VITE_* variables)
VITE_API_URL=http://127.0.0.1:3000/api/v1
