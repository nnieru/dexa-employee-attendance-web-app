          "value": "(\"attendance_adjustment_requests\".\"status\" = 'PENDING' and \"attendance_adjustment_requests\".\"reviewed_by_account_id\" is null and \"attendance_adjustment_requests\".\"reviewed_at\" is null) or (\"attendance_adjustment_requests\".\"status\" <> 'PENDING' and \"attendance_adjustment_requests\".\"reviewed_by_account_id\" is not null and \"attendance_adjustment_requests\".\"reviewed_at\" is not null)"
        },
        "attendance_adjustment_requests_self_review_ck": {
          "name": "attendance_adjustment_requests_self_review_ck",
          "value": "\"attendance_adjustment_requests\".\"reviewed_by_account_id\" is null or \"attendance_adjustment_requests\".\"reviewed_by_account_id\" <> \"attendance_adjustment_requests\".\"requested_by_account_id\""
        },
        "attendance_adjustment_requests_reviewed_at_ck": {
          "name": "attendance_adjustment_requests_reviewed_at_ck",
          "value": "\"attendance_adjustment_requests\".\"reviewed_at\" is null or \"attendance_adjustment_requests\".\"reviewed_at\" >= \"attendance_adjustment_requests\".\"created_at\""
        },
        "attendance_adjustment_requests_rejection_reason_ck": {
          "name": "attendance_adjustment_requests_rejection_reason_ck",
          "value": "\"attendance_adjustment_requests\".\"status\" <> 'REJECTED' or (\"attendance_adjustment_requests\".\"review_reason\" is not null and btrim(\"attendance_adjustment_requests\".\"review_reason\") <> '')"
        },
        "attendance_adjustment_requests_pending_review_reason_ck": {
          "name": "attendance_adjustment_requests_pending_review_reason_ck",
          "value": "\"attendance_adjustment_requests\".\"status\" <> 'PENDING' or \"attendance_adjustment_requests\".\"review_reason\" is null"
        },
        "attendance_adjustment_requests_base_revision_ck": {
          "name": "attendance_adjustment_requests_base_revision_ck",
          "value": "\"attendance_adjustment_requests\".\"base_revision\" >= 1"
        },
        "attendance_adjustment_requests_checkout_order_ck": {
          "name": "attendance_adjustment_requests_checkout_order_ck",
          "value": "\"attendance_adjustment_requests\".\"requested_checkout_at\" is null or \"attendance_adjustment_requests\".\"requested_checkin_at\" is null or \"attendance_adjustment_requests\".\"requested_checkout_at\" >= \"attendance_adjustment_requests\".\"requested_checkin_at\""
        },
        "attendance_adjustment_requests_checkout_needs_checkin_ck": {
          "name": "attendance_adjustment_requests_checkout_needs_checkin_ck",
          "value": "\"attendance_adjustment_requests\".\"requested_checkout_at\" is null or \"attendance_adjustment_requests\".\"requested_checkin_at\" is not null"
        },
